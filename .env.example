HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/campus.sqlite
# Generate separate random values: node --input-type=module -e "import {randomBytes} from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
READ_API_KEY=
INGEST_API_KEY=
TIME_ZONE=Asia/Manila
POLL_INTERVAL_MS=30000
FRESHNESS_MS=90000
BASELINE_MIN_SAMPLES=20
BASELINE_SIGMA=3
BASELINE_ALPHA=0.3
MIN_EXPECTED_BPS=1000
LATENCY_THRESHOLD_MS=100
PACKET_LOSS_THRESHOLD_PERCENT=10
CPU_THRESHOLD_PERCENT=85
# Existing Prometheus with snmp_exporter and blackbox_exporter; blank disables polling.
PROMETHEUS_URL=
PROMETHEUS_BEARER_TOKEN=
SNMP_JOB=snmp
ICMP_JOB=blackbox-icmp
# Optional vendor-specific Prometheus metric names, mapped by instance label.
CPU_METRIC=
THERMAL_METRIC=
SYSLOG_ENABLED=false
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=5514
# Messages from unregistered addresses are rejected; bind only on your management network.
NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# Email delivery through an institution-managed HTTPS email gateway accepting {to,subject,text}.
EMAIL_GATEWAY_URL=
EMAIL_GATEWAY_TOKEN=
EMAIL_TO=
# Hardware adapter URL and secret are per-device environment references in inventory.
REMEDIATION_ENABLED=false
REMEDIATION_COOLDOWN_MS=900000
RETENTION_DAYS=35
